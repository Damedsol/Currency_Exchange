{
	"semi": true,
	"tabWidth": 2,
	"printWidth": 80,
	"singleQuote": false,
	"trailingComma": "all",
	"useTabs": true,
	"endOfLine": "auto",
	"bracketSpacing": true,
	"arrowParens": "always",
	"proseWrap": "preserve",
	"htmlWhitespaceSensitivity": "css",
	"quoteProps": "as-needed",
	"embeddedLanguageFormatting": "auto"
}