{
	"name": "currencyexchange",
	"private": true,
	"version": "2.1.0",
	"author": {
		"email": "contact@damedsol.dev",
		"name": "Damedsol",
		"url": "https://www.linkedin.com/in/david-medina-soloza/"
	},
	"license": "CC BY 4.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "pnpm exec oxlint . --fix && pnpm ls-lint",
		"format": "biome format --write .",
		"prepare": "husky",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@fluentui/react-components": "catalog:",
		"@fluentui/react-icons": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@ls-lint/ls-lint": "catalog:",
		"@playwright/test": "catalog:",
		"@testing-library/jest-dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@testing-library/user-event": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"husky": "catalog:",
		"jsdom": "catalog:",
		"lint-staged": "catalog:",
		"oxlint": "catalog:",
		"playwright": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"engineStrict": true,
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=11.0.0"
	}
}
