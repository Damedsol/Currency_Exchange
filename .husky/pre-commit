#!/usr/bin/env sh

echo '👀 Running linters and formatters on staged files...'
echo ''

pnpm exec lint-staged
if [ $? != 0 ]; then
  echo
  echo '❌ There are code style issues. Please fix them before committing.'
  echo
  exit 1
fi

echo '🔍 Running TypeScript type checking...'
pnpm typecheck
if [ $? != 0 ]; then
  echo
  echo '❌ TypeScript type checking failed. Please fix type errors before committing.'
  echo
  exit 1
fi

echo ''
echo '✅ Code quality check passed successfully' 