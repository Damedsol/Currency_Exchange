# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - currencyExchange
# Copia este archivo a '.env.development' o '.env.production' y completa las variables.
# ==============================================================================

# Entorno de ejecución (development | production)
NODE_ENV=development

# URL base para las llamadas de la API de conversión de divisas
VITE_API_URL=http://localhost:3000/api

# Activar modo de depuración en consola para desarrolladores (true | false)
VITE_DEBUG=true

# Habilitar Hot Module Replacement (HMR) para desarrollo interactivo
VITE_HMR=true

# Forzar el uso de polling de Chokidar para sistemas de archivos virtuales (Docker)
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
FAST_REFRESH=true

# Nivel de log del sistema (debug | info | warn | error)
VITE_LOG_LEVEL=debug
